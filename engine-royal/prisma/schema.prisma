// engine-royal — data model.
//
// EXACT COPY of the website's prisma/schema.prisma. The engine shares the same
// PostgreSQL database as the website; this copy exists only so the engine can
// generate its own Prisma client and run independently. Keep it in sync with
// the website schema — do not diverge the models. The website owns the schema:
// migrations run from the website project only (prisma migrate deploy).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Users & auth ─────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  isBanned     Boolean  @default(false)
  clientSeed   String   @default("")
  referredBy   String?
  assignedWalletId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wallet    Wallet?
  bets      Bet[]
  txns      Transaction[]
  auditLogs AuditLog[]
}

// ───────────────────────────── Wallet & ledger ──────────────────────────

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  type         String
  amount       Int
  balanceAfter Int
  ref          String?
  meta         String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ───────────────────────────── Games ────────────────────────────────────

model GameRound {
  id             String    @id @default(cuid())
  game           String    // COLOR | CRASH | NUMBER
  period         BigInt
  state          String    @default("BETTING") // BETTING | RUNNING | SETTLED
  serverSeed     String
  serverSeedHash String
  result         String?
  forcedResult   String?
  startAt        DateTime
  lockAt         DateTime
  settleAt       DateTime
  settledAt      DateTime?
  createdAt      DateTime  @default(now())

  bets Bet[]

  @@unique([game, period])
  @@index([game, state])
  // Kept in sync with the website schema: serves the settlement-recency
  // Parity history feed (game + state equality, then settledAt desc).
  @@index([game, state, settledAt])
}

model Bet {
  id        String   @id @default(cuid())
  userId    String
  roundId   String
  game      String
  amount    Int
  // House fee on the stake; effectiveBet (= amount - feeAmount) drives payouts.
  feeAmount    Int   @default(0)
  effectiveBet Int   @default(0)
  selection String
  cashoutX  Int?
  status    String   @default("PENDING")
  payout    Int      @default(0)
  createdAt DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  round GameRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([roundId])
}

// ───────────────────────────── Referral rewards ─────────────────────────
// Kept in sync with the website schema. Engine unused.

model ReferralReward {
  id             String    @id @default(cuid())
  referrerId     String
  referredUserId String    @unique
  depositId      String    @unique
  amount         Int
  amountUsdt     Float
  status         String    @default("PENDING")
  createdAt      DateTime  @default(now())
  unlockAt       DateTime
  claimedAt      DateTime?

  @@index([referrerId, status])
  @@index([referrerId, createdAt])
}

// ───────────────────────────── Platform ─────────────────────────────────

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model HouseTransaction {
  id        String   @id @default(cuid())
  betId     String
  userId    String
  game      String
  fee       Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Crypto tables — kept in sync with the website schema. The TronGrid deposit
// poller and the withdrawal workflow run on the website; the engine does not
// use these models (defined here only so the two Prisma schemas stay identical).

model DepositWallet {
  id           String   @id @default(cuid())
  name         String
  address      String
  network      String   @default("TRC20")
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, displayOrder])
}

model Deposit {
  id            String    @id @default(cuid())
  userId        String
  walletId      String?
  toAddress     String?
  network       String    @default("TRC20")
  amountUsdt    Float
  coins         Int       @default(0)
  txid          String?
  fromAddress   String?
  confirmations Int       @default(0)
  status        String    @default("PENDING")
  adminId       String?
  note          String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
  creditedAt    DateTime?

  @@index([userId, createdAt])
  @@index([status])
  @@index([walletId, status])
}

model Withdrawal {
  id          String    @id @default(cuid())
  userId      String
  address     String
  coins       Int
  usdt        Float
  feeUsdt     Float
  receiveUsdt Float
  status      String    @default("PENDING")
  txid        String?
  adminId     String?
  note        String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([userId, createdAt])
  @@index([status])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
