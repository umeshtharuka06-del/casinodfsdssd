// Royal 1 — data model (PostgreSQL)
//
// Uses Prisma's PostgreSQL provider. Multi-row atomicity (wallet/betting/
// settlement code) uses standard Postgres transactions via prisma.$transaction —
// no special server topology is required.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" kept for RHEL-family serverless
  // hosts. The Docker image (debian bookworm) is covered by "native" at build time.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Users & auth ─────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  isBanned     Boolean  @default(false)
  // per-user provably-fair client seed (rotatable)
  clientSeed   String   @default("")
  // Referral: the userId of the referrer, set ONCE at registration and never
  // changed (so an existing user can never be reassigned). Null = organic signup.
  referredBy   String?
  // The deposit wallet currently LOCKED to this user. Assigned at random from the
  // active pool on the first deposit visit and held (across refresh/logout/login)
  // until a deposit is APPROVED, at which point it is cleared so the next request
  // rotates to a new random wallet.
  assignedWalletId String?
  // ── VIP (see VIPHistory, lib/vip.ts) ──
  // Cached current VIP tier (0 = none). Recomputed automatically on deposit
  // approval and other qualifying events. When `vipOverride` is non-null an
  // admin has pinned the tier manually and automatic recomputation is suppressed.
  vipLevel     Int      @default(0)
  vipOverride  Int?
  // Manual (+/-) adjustment an admin applies to this user's qualified-referral
  // count. Added on top of the computed count wherever it is used (VIP
  // qualification, dashboards, withdrawal eligibility). Default 0 = no change.
  referralAdjustment Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wallet    Wallet?
  bets      Bet[]
  txns      Transaction[]
  auditLogs AuditLog[]
}

// ───────────────────────────── Wallet & ledger ──────────────────────────

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  // balance is stored in integer "coin cents" (1 coin = 100) to avoid float drift
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Every balance change is recorded as an immutable ledger row.
model Transaction {
  id           String   @id @default(cuid())
  userId       String
  type         String   // SIGNUP_BONUS | BET | PAYOUT | DEPOSIT | WITHDRAWAL | ADMIN_CREDIT | ADMIN_DEBIT
  amount       Int      // signed coin-cents, +credit / -debit
  balanceAfter Int
  ref          String?  // related bet id / external txn ref
  meta         String?  // JSON string
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ───────────────────────────── Games ────────────────────────────────────

model GameRound {
  id             String    @id @default(cuid())
  game           String    // COLOR | CRASH | NUMBER
  period         BigInt    // monotonic round number
  state          String    @default("BETTING") // BETTING | RUNNING | SETTLED
  // provably fair
  serverSeed     String
  serverSeedHash String
  // outcome (game-specific, JSON encoded)
  result         String?
  // Admin override set from the panel BEFORE settlement. JSON, game-specific:
  //   COLOR  → {"color":"RED"} or {"digit":3}
  //   NUMBER → {"digit":7}
  // When present, the prediction engine uses this instead of its own decision.
  forcedResult   String?
  startAt        DateTime
  lockAt         DateTime // betting closes
  settleAt       DateTime
  settledAt      DateTime?
  createdAt      DateTime  @default(now())

  bets Bet[]

  @@unique([game, period])
  @@index([game, state])
  // Serves the settlement-recency history feed (game + state equality, then
  // settledAt desc) without an in-memory sort at scale.
  @@index([game, state, settledAt])
}

model Bet {
  id        String   @id @default(cuid())
  userId    String
  roundId   String
  game      String   // COLOR | CRASH
  amount    Int      // coin-cents staked (gross — what the user is debited)
  // House fee taken on the stake. effectiveBet = amount - feeAmount and is what
  // settlement uses to compute payouts. Legacy rows have feeAmount 0 / effectiveBet 0.
  feeAmount    Int   @default(0)
  effectiveBet Int   @default(0)
  // COLOR: selection = "RED" | "GREEN" | "VIOLET"
  // CRASH: selection = autoCashout multiplier x100 (e.g. "200" = 2.00x), "0" = manual
  selection String
  // CRASH manual/auto cashout multiplier achieved x100, null if not cashed
  cashoutX  Int?
  status    String   @default("PENDING") // PENDING | WON | LOST | CASHED
  payout    Int      @default(0) // coin-cents returned (0 if lost)
  createdAt DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  round GameRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([roundId])
}

// ───────────────────────────── Referral rewards ─────────────────────────
//
// When a referred user makes their FIRST successful (approved) deposit, the
// referrer earns a fixed USDT-equivalent reward. The reward NEVER goes
// straight to the main wallet: it is created PENDING (referral balance),
// unlocks `referral_lock_days` (7) days later, and the referrer must press
// "Claim" to transfer it into the wallet ledger.
model ReferralReward {
  id             String    @id @default(cuid())
  referrerId     String    // who earns the reward
  referredUserId String    @unique // the depositor — one reward ever (first deposit only)
  depositId      String    @unique // the qualifying deposit (reference)
  amount         Int       // coin-cents
  amountUsdt     Float     // reward face value in USDT (e.g. 4)
  // PENDING (locked or claimable — claimable once unlockAt has passed) | CLAIMED
  status         String    @default("PENDING")
  createdAt      DateTime  @default(now()) // reward created date
  unlockAt       DateTime  // createdAt + holding period; claimable after this
  claimedAt      DateTime?

  @@index([referrerId, status])
  @@index([referrerId, createdAt])
}

// ───────────────────────────── Platform ─────────────────────────────────

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// House fee taken on every bet (revenue ledger, separate from the player wallet
// ledger). One row per fee charged, so the admin dashboard can total fee income
// over any time window.
model HouseTransaction {
  id        String   @id @default(cuid())
  betId     String
  userId    String
  game      String
  fee       Int      // coin-cents taken as house fee
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ───────────────────────── Crypto (TRC20 USDT) ──────────────────────────
//
// Deposit wallets are admin-managed. Each user is randomly assigned ONE active
// wallet (locked until their deposit completes). A deposit is a user-initiated
// REQUEST: the user sends USDT to the assigned wallet then clicks "I Have Paid".
// The TronGrid poller then watches that wallet and matches the incoming transfer
// by amount, auto-crediting on confirmation; the admin can also approve/reject.

// Admin-managed pool of TRC20 receive addresses users are randomly assigned.
model DepositWallet {
  id           String   @id @default(cuid())
  name         String   // human label, e.g. "Wallet 1"
  address      String   // TRC20 receive address
  network      String   @default("TRC20")
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, displayOrder])
}

// A user-initiated deposit request against an assigned wallet.
// walletId/toAddress are optional only to tolerate legacy on-chain deposit rows
// imported from the previous auto-detect system — the new request flow always
// populates them.
model Deposit {
  id            String    @id @default(cuid())
  userId        String
  walletId      String?   // the DepositWallet assigned at request time
  toAddress     String?             // snapshot of the assigned wallet address
  network       String    @default("TRC20")
  amountUsdt    Float               // amount the user says they sent
  coins         Int       @default(0) // coin-cents credited on approval
  // How the user says they paid. ONCHAIN = a TRC20 transfer the poller can
  // verify automatically. OFFCHAIN = an internal/exchange transfer reference
  // that CANNOT be chain-verified — it always goes to manual admin review and
  // is excluded from the poller's auto-credit path.
  txType        String    @default("ONCHAIN")
  // On-chain match (filled by the poller, optional if approved manually).
  txid          String?             // on-chain transaction id (deduped in code)
  fromAddress   String?
  confirmations Int       @default(0)
  // PENDING (awaiting verification) | APPROVED (credited) | REJECTED
  status        String    @default("PENDING")
  adminId       String?   // admin who approved/rejected
  note          String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
  creditedAt    DateTime?

  @@index([userId, createdAt])
  @@index([status])
  @@index([walletId, status])
  // Serves the admin manual-review queue (OFFCHAIN + PENDING).
  @@index([txType, status])
}

model Withdrawal {
  id          String    @id @default(cuid())
  userId      String
  address     String              // TRC20 destination address
  coins       Int                 // coin-cents debited (held at request time)
  usdt        Float               // coins / conversion rate
  feeUsdt     Float
  receiveUsdt Float               // usdt - fee (what the user is sent)
  // PENDING | APPROVED | COMPLETED | REJECTED
  status      String    @default("PENDING")
  txid        String?             // set when the admin marks it COMPLETED
  adminId     String?
  note        String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([userId, createdAt])
  @@index([status])
}

// Key/value settings editable from the admin panel (e.g. signup bonus).
// The natural string key is the primary key.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  detail    String?  // JSON string
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  // Serves the per-user login history (admin drawer) and the user-list
  // "last login" lookup (userId + action equality, then createdAt).
  @@index([userId, action, createdAt])
}

// ─────────────────────── Advanced business logic ────────────────────────
//
// The models below are ADDITIVE — they extend the platform with VIP tiers,
// casino-accounting, referral qualification and withdrawal-eligibility
// analytics without altering any existing table. They follow the existing
// convention (plain indexed `userId` columns, no formal User relation) used by
// Deposit / Withdrawal / HouseTransaction. Money is coin-cents (1 coin = 100)
// unless a field is explicitly named `*Usdt`.

// Immutable log of every VIP tier change (automatic or admin override).
model VIPHistory {
  id        String   @id @default(cuid())
  userId    String
  oldLevel  Int      @default(0)
  newLevel  Int
  // AUTO_DEPOSIT | AUTO_REFERRAL | ADMIN_OVERRIDE | ADMIN_CLEAR_OVERRIDE
  reason    String
  detail    String?  // JSON snapshot of the qualifying metrics
  adminId   String?  // set for admin-initiated changes
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Platform-side (house) revenue/expense ledger. One immutable row per event,
// signed from the HOUSE perspective: +credit is house revenue, -debit is a
// house payout/expense. Bet fees and player win/loss are derived from the Bet /
// HouseTransaction tables directly; this ledger captures the entries that have
// no other source of truth — VIP bonuses paid and manual admin adjustments —
// plus optional mirrored entries used by the realtime P/L recalculation.
model FinancialLedger {
  id        String   @id @default(cuid())
  // BET_FEE | WITHDRAW_FEE | PLAYER_LOSS | PLAYER_WIN | REFERRAL_PAYOUT |
  // VIP_BONUS | MANUAL_ADJUSTMENT
  type      String
  amount    Int      // signed coin-cents (house perspective)
  ref       String?  // related entity id (bet, withdrawal, reward, …)
  userId    String?  // related user, when applicable
  note      String?
  adminId   String?  // set for MANUAL_ADJUSTMENT
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
}

// House fee charged on every bet stake. NOTE: the authoritative bet-fee ledger
// is the existing `HouseTransaction` table (kept as the single source of truth
// to avoid double counting). This model exists per the schema spec as a typed
// alias/view target; new fee writes continue to go to HouseTransaction and the
// analytics layer reads from there. Left as a thin table for forward use.
model BetFee {
  id        String   @id @default(cuid())
  betId     String   @unique
  userId    String
  game      String
  fee       Int      // coin-cents
  feePct    Float    @default(0) // effective fee percentage at charge time
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Fee collected on each processed withdrawal (revenue ledger, mirrors the way
// HouseTransaction records bet fees). One row per withdrawal.
model WithdrawFee {
  id           String   @id @default(cuid())
  withdrawalId String   @unique
  userId       String
  feeUsdt      Float
  feeCoins     Int      // coin-cents equivalent at the configured rate
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// Explicit qualification record for a referred user. A referral only "counts"
// once the referred user completes at least one APPROVED deposit. Created
// PENDING at registration (when referredBy is set), moved to QUALIFIED on the
// first approved deposit, and REJECTED can be set manually by an admin.
model ReferralQualification {
  id             String    @id @default(cuid())
  referrerId     String
  referredUserId String    @unique
  // PENDING | QUALIFIED | REJECTED
  status         String    @default("PENDING")
  depositId      String?   // the qualifying deposit, when QUALIFIED
  qualifiedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([referrerId, status])
}

// Analytics record written whenever a withdrawal request is blocked by an
// eligibility rule. The user always sees the accurate reason (transparent
// validation); this table gives the admin a searchable history of blocks.
model WithdrawalRestriction {
  id        String   @id @default(cuid())
  userId    String
  // DAILY_LIMIT | MIN_AMOUNT | FEE_FLOOR | TURNOVER | REFERRAL_QUALIFICATION
  reason    String
  coins     Int      // attempted amount (coin-cents)
  detail    String?  // JSON with the thresholds/values involved
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Daily house financial breakdown, one row per UTC day. Written by the snapshot
// job (lib/analytics.ts) and read by the dashboard trend charts so historical
// trends don't require scanning the full ledger each load.
model ProfitSnapshot {
  id           String   @id @default(cuid())
  day          DateTime @unique // UTC midnight for the day summarised
  houseProfit  Int      // coin-cents (the Part 2 formula result)
  betFees      Int
  withdrawFees Int
  playerLosses Int
  playerWins   Int
  referralPaid Int
  vipPaid      Int
  manualAdj    Int
  createdAt    DateTime @default(now())

  @@index([day])
}

// Free-form admin note attached to a user (Part 10). Multiple timestamped notes
// per user; append-only from the admin panel.
model AdminNote {
  id        String   @id @default(cuid())
  userId    String
  adminId   String
  body      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Daily player-activity / volume metrics, one row per UTC day. Complements
// ProfitSnapshot (which is house-side money); this is player-side counts/volume.
model PlatformAnalytics {
  id              String   @id @default(cuid())
  day             DateTime @unique
  newUsers        Int      @default(0)
  activeUsers     Int      @default(0)
  depositCount    Int      @default(0)
  depositCoins    Int      @default(0)
  withdrawCount   Int      @default(0)
  withdrawCoins   Int      @default(0)
  betCount        Int      @default(0)
  wagered         Int      @default(0)
  payout          Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([day])
}
